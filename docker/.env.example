# Copy to .env (never commit .env) and replace every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 32   (hex only: safe inside URLs)

STACK_NAME=suitestream
RESTART_POLICY=unless-stopped
TZ=America/Chicago
DATA_DIR=./data

# App
APP_IMAGE=suitestream:local
APP_PORT=8080
# Public address of the app, no trailing slash, no path.
PUBLIC_URL=https://calendar.example.com
SESSION_HOURS=24

# Database
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# Authentik
AUTHENTIK_TAG=2025.10.1
AUTHENTIK_PORT=9000
AUTHENTIK_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Sign-in: create an OAuth2/OpenID provider and application in Authentik
# (redirect URI = PUBLIC_URL + /auth/callback, confidential client), then copy:
# Issuer = Authentik's OpenID Configuration Issuer, ends in /application/o/<slug>/
# It must be reachable from inside the app container and from the browser.
OIDC_ISSUER=https://auth.example.com/application/o/suitestream/
OIDC_CLIENT_ID=CHANGE_ME_from_authentik
OIDC_CLIENT_SECRET=CHANGE_ME_from_authentik

# Watchtower token (the app uses it to ask for an update)
WATCHTOWER_TOKEN=CHANGE_ME_openssl_rand_hex_32
